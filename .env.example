# i-Speak Diagnostic API — environment template
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit it.

# ─── Environment ──────────────────────────────────────────────────────────
# development | testing | production
APP_ENV=development
APP_PORT=8000

# ─── Supabase ─────────────────────────────────────────────────────────────
# Use the service_role key ONLY on the backend; never expose it to a frontend.
SUPABASE_URL=
SUPABASE_KEY=

# ─── LLM (Groq) ───────────────────────────────────────────────────────────
GROQ_API_KEY=

# ─── Embedding & RAG ──────────────────────────────────────────────────────
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.75

# ─── Security ─────────────────────────────────────────────────────────────
# Set true in production. Requires API_KEYS and/or ADMIN_API_KEYS.
API_KEY_AUTH_ENABLED=false
# JSON array or comma-separated list of valid client keys.
API_KEYS=
# Keys with admin rights (can list/delete all feedback).
ADMIN_API_KEYS=

# Rate limiting (in-memory; per process). Set true in production.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
ANALYZE_RATE_LIMIT_PER_MINUTE=10
ASSESS_RATE_LIMIT_PER_MINUTE=10

# ─── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list or JSON array of allowed origins.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ─── Documentation endpoints (Swagger/ReDoc/OpenAPI) ──────────────────────
DOCS_ENABLED=true

# ─── Audio upload ─────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
AUDIO_MAX_DURATION_SEC=300
ALLOWED_AUDIO_EXTENSIONS=.wav,.mp3,.m4a,.ogg
